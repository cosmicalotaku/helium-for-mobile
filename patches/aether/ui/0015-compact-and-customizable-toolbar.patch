diff --git a/chrome/android/java/src/org/chromium/chrome/browser/settings/ToolbarCustomizationSettings.java b/chrome/android/java/src/org/chromium/chrome/browser/settings/ToolbarCustomizationSettings.java
new file mode 100644
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/settings/ToolbarCustomizationSettings.java
@@ -0,0 +1,24 @@
+package org.chromium.chrome.browser.settings;
+
+import android.os.Bundle;
+import androidx.preference.PreferenceFragmentCompat;
+import org.chromium.chrome.R;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
+
+/**
+ * Fragment for configuring visible shortcut buttons in the mobile toolbar.
+ */
+public class ToolbarCustomizationSettings extends PreferenceFragmentCompat {
+    public static final String PREF_TOOLBAR_UBLOCK = "aether_toolbar_show_ublock";
+    public static final String PREF_TOOLBAR_EXTENSIONS = "aether_toolbar_show_extensions";
+    public static final String PREF_TOOLBAR_HOME = "aether_toolbar_show_home";
+    public static final String PREF_TOOLBAR_SHARE = "aether_toolbar_show_share";
+    public static final String PREF_TOOLBAR_NEW_TAB = "aether_toolbar_show_new_tab";
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        setPreferencesFromResource(R.xml.toolbar_customization_preferences, rootKey);
+        getActivity().setTitle(R.string.toolbar_customization_title);
+    }
+}

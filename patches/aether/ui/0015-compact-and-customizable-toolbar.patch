+++ b/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/top/ToolbarPhone.java
@@ -25,6 +25,8 @@ import android.view.View;
 import android.view.ViewGroup;
 import android.widget.FrameLayout;
 import android.widget.TextView;
+import android.content.SharedPreferences;
+import org.chromium.base.ContextUtils;
 
 import androidx.annotation.Nullable;
 
@@ -87,6 +89,8 @@ public class ToolbarPhone extends ToolbarLayout implements View.OnClickListener,
     private TextView mUrlBar;
     private View mOptionalButton;
     private View mUblockQuickButton;
+    private View mShareButton;
+    private View mNewTabButton;
 
     @Override
     protected void onFinishInflate() {
@@ -112,6 +116,38 @@ public class ToolbarPhone extends ToolbarLayout implements View.OnClickListener,
                 return true;
             });
         }
+        mShareButton = findViewById(R.id.share_button);
+        mNewTabButton = findViewById(R.id.new_tab_button);
+        if (mNewTabButton != null) {
+            mNewTabButton.setOnClickListener(v -> {
+                if (getToolbarTabController() != null) {
+                    getToolbarTabController().openNewTab();
+                }
+            });
+        }
+        updateCustomToolbarButtons();
+    }
+
+    public void updateCustomToolbarButtons() {
+        SharedPreferences prefs = ContextUtils.getAppSharedPreferences();
+        boolean showUblock = prefs.getBoolean("aether_toolbar_show_ublock", true);
+        boolean showExtensions = prefs.getBoolean("aether_toolbar_show_extensions", true);
+        boolean showHome = prefs.getBoolean("aether_toolbar_show_home", false);
+        boolean showShare = prefs.getBoolean("aether_toolbar_show_share", false);
+        boolean showNewTab = prefs.getBoolean("aether_toolbar_show_new_tab", false);
+
+        if (mUblockQuickButton != null) {
+            mUblockQuickButton.setVisibility(showUblock ? View.VISIBLE : View.GONE);
+        }
+        View extContainer = findViewById(R.id.extensions_toolbar_container);
+        if (extContainer != null) {
+            extContainer.setVisibility(showExtensions ? View.VISIBLE : View.GONE);
+        }
+        if (mHomeButton != null) {
+            mHomeButton.setVisibility(showHome ? View.VISIBLE : View.GONE);
+        }
+        if (mShareButton != null) {
+            mShareButton.setVisibility(showShare ? View.VISIBLE : View.GONE);
+        }
+        if (mNewTabButton != null) {
+            mNewTabButton.setVisibility(showNewTab ? View.VISIBLE : View.GONE);
+        }
     }
 
     @Override

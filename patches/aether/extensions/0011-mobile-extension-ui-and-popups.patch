From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Aether Browser Maintainers <maintainers@aether.browser>
Date: Thu, 5 Nov 2026 00:00:00 +0000
Subject: [PATCH] [extensions] Implement Android mobile extension UI, toolbar container, and responsive popups
Feature: FEAT-08
Origin: adapted-from:patches/titanium/mobile-extension-ui.patch

Injects extension toolbar container stub into phone toolbar layout, enables
toolbar drawing of extension actions on mobile, implements responsive viewport
sizing for extension action popups on phone form factors, and adapts
chrome://extensions WebUI styles for mobile touch displays.
---
 chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java                                  |  2 +-
 chrome/browser/resources/extensions/extensions.html                                                             |  1 +
 chrome/browser/resources/extensions/item_list.css                                                                |  2 +-
 chrome/browser/resources/extensions/shared_vars.css                                                             |  2 +-
 chrome/browser/resources/extensions/toggle_row.css                                                               |  2 +-
 chrome/browser/ui/android/extensions/extension_action_popup_contents.cc                                         | 10 ++++++++++
 chrome/browser/ui/android/toolbar/java/res/layout/toolbar_phone.xml                                              |  7 +++++++
 chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/extensions/ExtensionActionPopup.java |  3 +++
 chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/top/ToolbarPhone.java            |  7 +++++++
 9 files changed, 33 insertions(+), 5 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java b/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
--- a/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/toolbar/ToolbarManager.java
@@ -520,7 +520,7 @@ public class ToolbarManager implements ToolbarTabController, UrlFocusChangeList
         mExtensionToolbarCoordinator =
                 new ExtensionToolbarCoordinator(
                         mActivity,
-                        (ToolbarTablet) mToolbarLayout,
+                        mToolbarLayout,
                         mProfileSupplier);
 
diff --git a/chrome/browser/resources/extensions/extensions.html b/chrome/browser/resources/extensions/extensions.html
--- a/chrome/browser/resources/extensions/extensions.html
+++ b/chrome/browser/resources/extensions/extensions.html
@@ -7,6 +7,7 @@
   <title>$i18n{title}</title>
   <base href="chrome://extensions">
   <meta name="color-scheme" content="light dark">
+  <meta name="viewport" content="width=device-width">
   <link rel="stylesheet" href="chrome://resources/css/md_colors.css">
   <style>
diff --git a/chrome/browser/resources/extensions/item_list.css b/chrome/browser/resources/extensions/item_list.css
--- a/chrome/browser/resources/extensions/item_list.css
+++ b/chrome/browser/resources/extensions/item_list.css
@@ -10,7 +10,7 @@
   --extensions-card-margin: 12px;
-  --extensions-card-width: 400px;
+  --extensions-card-width: 96%;
   display: block;
   height: 100%;
diff --git a/chrome/browser/resources/extensions/shared_vars.css b/chrome/browser/resources/extensions/shared_vars.css
--- a/chrome/browser/resources/extensions/shared_vars.css
+++ b/chrome/browser/resources/extensions/shared_vars.css
@@ -11,7 +11,7 @@
   --cr-toolbar-center-margin: 0;
-  --cr-toolbar-field-width: 680px;
+  --cr-toolbar-field-width: 96%;
   --extensions-card-margin: 12px;
diff --git a/chrome/browser/resources/extensions/toggle_row.css b/chrome/browser/resources/extensions/toggle_row.css
--- a/chrome/browser/resources/extensions/toggle_row.css
+++ b/chrome/browser/resources/extensions/toggle_row.css
@@ -11,7 +11,7 @@
   cursor: pointer;
   min-height: 48px;
-  touch-action: none;
+  touch-action: pan-y;
   user-select: none;
 }
diff --git a/chrome/browser/ui/android/extensions/extension_action_popup_contents.cc b/chrome/browser/ui/android/extensions/extension_action_popup_contents.cc
--- a/chrome/browser/ui/android/extensions/extension_action_popup_contents.cc
+++ b/chrome/browser/ui/android/extensions/extension_action_popup_contents.cc
@@ -12,6 +12,7 @@
 #include "base/android/jni_android.h"
 #include "base/android/jni_string.h"
+#include "ui/base/device_form_factor.h"
 #include "chrome/browser/extensions/extension_view_host.h"
 
@@ -85,6 +86,10 @@ void ExtensionActionPopupContents::DocumentOnLoadCompletedInPrimaryMainFrame()
   content::RenderFrameHost* render_frame_host = web_contents_->GetPrimaryMainFrame();
+  if (ui::GetDeviceFormFactor() == ui::DEVICE_FORM_FACTOR_PHONE) {
+    return;
+  }
   render_frame_host->GetView()->EnableAutoResize(kMinSize, kMaxSize);
 }
 
@@ -110,6 +115,11 @@ void ExtensionActionPopupContents::OnLoaded() {
   // Notification that the popup has completed loading.
+  if (ui::GetDeviceFormFactor() == ui::DEVICE_FORM_FACTOR_PHONE) {
+    Java_ExtensionActionPopupContents_resizeDueToAutoResize(
+        AttachCurrentThread(), java_object_, 100000, 100000);
+  }
 }
diff --git a/chrome/browser/ui/android/toolbar/java/res/layout/toolbar_phone.xml b/chrome/browser/ui/android/toolbar/java/res/layout/toolbar_phone.xml
--- a/chrome/browser/ui/android/toolbar/java/res/layout/toolbar_phone.xml
+++ b/chrome/browser/ui/android/toolbar/java/res/layout/toolbar_phone.xml
@@ -112,6 +112,13 @@
             android:layout_width="wrap_content"
             android:layout_height="?attr/toolbarButtonHeight"
             android:layout_marginVertical="?attr/toolbarButtonMarginVertical" />
+        <ViewStub
+            android:id="@+id/extensions_toolbar_container_stub"
+            android:inflatedId="@+id/extensions_toolbar_container"
+            android:layout_width="wrap_content"
+            android:layout_height="?attr/toolbarButtonHeight"
+            android:layout_marginVertical="?attr/toolbarButtonMarginVertical" />
 
         <org.chromium.chrome.browser.toolbar.top.ToggleTabStackButton
             android:id="@+id/tab_switcher_button"
diff --git a/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/extensions/ExtensionActionPopup.java b/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/extensions/ExtensionActionPopup.java
--- a/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/extensions/ExtensionActionPopup.java
+++ b/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/extensions/ExtensionActionPopup.java
@@ -65,6 +65,9 @@ public class ExtensionActionPopup {
     public void show(View anchor) {
+        View decor = activity.getWindow().getDecorView();
+        webContents.setSize(decor.getWidth(), decor.getHeight());
+
         mPopupWindowAndroid =
                 new PopupWindowAndroid(
                         activity,
diff --git a/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/top/ToolbarPhone.java b/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/top/ToolbarPhone.java
--- a/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/top/ToolbarPhone.java
+++ b/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/top/ToolbarPhone.java
@@ -410,6 +410,13 @@ public class ToolbarPhone extends ToolbarLayout implements View.OnClickListener,
     protected void dispatchDraw(Canvas canvas) {
         super.dispatchDraw(canvas);
+        View extContainer = findViewById(R.id.extensions_toolbar_container);
+        if (extContainer != null && extContainer.getVisibility() != View.GONE && extContainer.getWidth() != 0) {
+            canvas.save();
+            ViewUtils.translateCanvasToView(mToolbarButtonsContainer, extContainer, canvas);
+            extContainer.draw(canvas);
+            canvas.restore();
+        }
         // Draw the signin button if visible.
     }
-- 
